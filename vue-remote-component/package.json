{
  "name": "vue-remote-component",
  "version": "2.0.2",
  "description": "Load a Vue component at runtime from a URL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saraedum/vue-remote-component.git",
    "directory": "vue-remote-component"
  },
  "scripts": {
    "dev": "vite dev --config vite.config.mts dev",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "main": "dist/vue-remote-component.ssr.js",
  "module": "dist/vue-remote-component.esm.js",
  "browser": "dist/vue-remote-component.ssr.js",
  "unpkg": "dist/vue-remote-component.min.js",
  "types": "dist/main.d.ts",
  "files": [
    "dist/*",
    "LICENSE"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  }
}
